local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "MIO HUB V7 - Rayfield",
   LoadingTitle = "MIO HUB V7",
   ConfigurationSaving = { Enabled = false }
})

-- AIMBOT SIN FOV
local Tab1 = Window:CreateTab("Aimbot", 4483362458)
local aimbotEnabled = false
local aimbotPart = "Head"
Tab1:CreateToggle({Name = "Aimbot Sin FOV", CurrentValue = false, Callback = function(v) aimbotEnabled = v end,})
Tab1:CreateDropdown({Name = "Parte", Options = {"Head","HumanoidRootPart"}, CurrentOption = "Head", Callback = function(o) aimbotPart = o[1] end,})

game:GetService("RunService").RenderStepped:Connect(function()
    if aimbotEnabled then
        local closest, dist = nil, math.huge
        for _,v in pairs(game.Players:GetPlayers()) do
            if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild(aimbotPart) then
                local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(v.Character[aimbotPart].Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X,pos.Y) - Vector2.new(game.Players.LocalPlayer:GetMouse().X, game.Players.LocalPlayer:GetMouse().Y)).Magnitude
                    if mag < dist then dist = mag closest = v end
                end
            end
        end
        if closest and closest.Character:FindFirstChild(aimbotPart) then
            workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, closest.Character[aimbotPart].Position)
        end
    end
end)

